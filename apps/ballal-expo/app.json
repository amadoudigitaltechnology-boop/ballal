{
  "expo": {
    "name": "BALLAL",
    "slug": "ballal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.amadoutechnology.ballal",
      "supportsTablet": false
    },
    "android": {
      "package": "com.amadoutechnology.ballal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "scheme": "ballal",
    "experiments": {
      "typedRoutes": true
    }
  }
}
